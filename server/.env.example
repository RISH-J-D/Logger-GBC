# ── Central server configuration ───────────────────────────────────────────
# Copy this file to ".env" and adjust for your environment.

# HTTP port the server (API + admin portal) listens on
PORT=4000

# PostgreSQL connection. Either set DATABASE_URL, or the individual PG* vars.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/device_logger
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=device_logger

# Secret used to sign admin portal session tokens. CHANGE THIS in production.
JWT_SECRET=change-me-to-a-long-random-string

# Admin portal login (the person who monitors all employees)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Idle threshold the agents enforce, in seconds (informational; the agent also
# ships with its own default). 300 = 5 minutes.
IDLE_TIMEOUT_SECONDS=300
